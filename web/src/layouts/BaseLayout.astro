---
// KDB Hukuk — Ortak sayfa iskeleti (header, mobil menü, footer, çerez
// banner, randevu modal, script etiketleri). Statik sitedeki tüm sayfalarda
// birebir aynı olan bu bölümler buraya taşınmıştır; tasarımda hiçbir
// değişiklik yapılmamıştır.
import { getSiteSettings } from '../lib/api';

export interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  activeNav?: 'home' | 'about' | 'services' | 'blog' | 'contact' | null;
  headerScrolled?: boolean;
  robots?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = 'website',
  jsonLd,
  activeNav = null,
  headerScrolled = false,
  robots = 'index, follow',
} = Astro.props;

const siteSettings = await getSiteSettings();
const siteUrl = 'https://www.kdbhukuk.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;

const jsonLdGraph = jsonLd
  ? JSON.stringify(Array.isArray(jsonLd) || (jsonLd as any)['@graph'] ? jsonLd : { '@context': 'https://schema.org', ...jsonLd })
  : null;

const navItems = [
  { key: 'home', href: '/', label: 'Ana Sayfa', index: '01' },
  { key: 'about', href: '/hakkimizda', label: 'Hakkımızda', index: '02' },
  { key: 'services', href: '/hizmetlerimiz', label: 'Hizmetlerimiz', index: '03' },
  { key: 'blog', href: '/blog', label: 'Blog', index: '04' },
  { key: 'contact', href: '/iletisim', label: 'İletişim', index: '05' },
];
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>document.documentElement.classList.add("js");</script>

  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content="KDB Hukuk">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="tr_TR">

  <!-- Twitter Card -->
  <meta name="twitter:card" content={ogType === 'article' ? 'summary_large_image' : 'summary'}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/assets/css/reset.css">
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/responsive.css">

  {jsonLdGraph && (
    <script type="application/ld+json" set:html={jsonLdGraph} is:inline />
  )}

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">İçeriğe geç</a>
  <div class="page-veil" id="page-veil" aria-hidden="true">
    <span class="page-veil__mark">KDB</span>
  </div>

  <!-- Header -->
  <header class:list={["site-header", { "is-scrolled": headerScrolled }]}>
    <div class="container site-header__inner">
      <a class="brand" href="/" aria-label="KDB Hukuk — Ana Sayfa">
        <span class="brand__row"><span class="brand__mark">KDB</span><span class="brand__suffix">Hukuk</span></span>
        <span class="brand__sub">Av. Kaan Durali Bulut</span>
      </a>

      <nav class="site-nav" aria-label="Ana menü">
        <ul class="site-nav__list">
          {navItems.map((item) => (
            <li><a class="site-nav__link" href={item.href} aria-current={activeNav === item.key ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
        <button class="btn btn--ghost site-nav__cta" type="button" data-appointment-open>Randevu Al</button>
      </nav>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menüyü aç">
        <span class="nav-toggle__box">
          <span class="nav-toggle__line"></span>
          <span class="nav-toggle__line"></span>
        </span>
      </button>
    </div>
  </header>

  <!-- Mobil menü -->
  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav__top">
      <a class="brand brand--light" href="/" aria-label="KDB Hukuk — Ana Sayfa">
        <span class="brand__row"><span class="brand__mark">KDB</span><span class="brand__suffix">Hukuk</span></span>
        <span class="brand__sub">Av. Kaan Durali Bulut</span>
      </a>
    </div>
    <nav aria-label="Mobil menü">
      <ul class="mobile-nav__list">
        {navItems.map((item) => (
          <li class="mobile-nav__item">
            <a class="mobile-nav__link" href={item.href} aria-current={activeNav === item.key ? 'page' : undefined}>
              <span class="mobile-nav__index">{item.index}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-nav__footer">
      <span>KDB Hukuk — Av. Kaan Durali Bulut</span>
      <a href="/iletisim">İletişim bilgileri için tıklayınız</a>
      <button class="btn btn--light" type="button" data-appointment-open>Randevu Al</button>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__main">
        <div>
          <a class="brand" href="/" aria-label="KDB Hukuk — Ana Sayfa">
            <span class="brand__row"><span class="brand__mark">KDB</span><span class="brand__suffix">Hukuk</span></span>
            <span class="brand__sub">Av. Kaan Durali Bulut</span>
          </a>
          <p class="site-footer__statement">Hukuki süreçlerde güvenilir ve stratejik çözüm ortağınız.</p>
        </div>

        <nav aria-label="Kurumsal bağlantılar">
          <h2 class="site-footer__heading">Kurumsal</h2>
          <ul class="site-footer__list" role="list">
            <li><a href="/">Ana Sayfa</a></li>
            <li><a href="/hakkimizda">Hakkımızda</a></li>
            <li><a href="/hizmetlerimiz">Hizmetlerimiz</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/iletisim">İletişim</a></li>
          </ul>
        </nav>

        <nav aria-label="Hukuki bağlantılar">
          <h2 class="site-footer__heading">Hukuki</h2>
          <ul class="site-footer__list" role="list">
            <li><a href="/kvkk">KVKK Aydınlatma Metni</a></li>
            <li><a href="/gizlilik-politikasi">Gizlilik Politikası</a></li>
            <li><a href="/cerez-politikasi">Çerez Politikası</a></li>
          </ul>
        </nav>

        <div>
          <h2 class="site-footer__heading">İletişim</h2>
          <address class="site-footer__list">
            <div class="office-phone">{siteSettings.phone || 'Telefon bilgisi eklenecektir'}</div>
            <div class="office-email">{siteSettings.email || 'E-posta bilgisi eklenecektir'}</div>
            <div class="office-address">{siteSettings.address || 'Adres bilgisi eklenecektir'}</div>
          </address>
        </div>
      </div>

      <div class="site-footer__bottom">
        <p>© 2026 KDB Hukuk. Tüm hakları saklıdır.</p>
        <p>Av. Kaan Durali Bulut</p>
      </div>
    </div>
  </footer>

  <!-- Çerez Banner -->
  <aside class="cookie-banner" id="cookie-banner" aria-label="Çerez bildirimi" hidden>
    <h2 class="cookie-banner__title">Çerez Kullanımı</h2>
    <p class="cookie-banner__text">
      Bu web sitesi kullanıcı deneyimini geliştirmek amacıyla çerezler
      kullanmaktadır. Ayrıntılı bilgi için
      <a href="/cerez-politikasi">Çerez Politikası</a> sayfasını
      inceleyebilirsiniz.
    </p>
    <div class="cookie-prefs">
      <div class="cookie-pref">
        <label for="cookie-pref-necessary">
          <span class="cookie-pref__name">Zorunlu Çerezler</span>
          <span class="cookie-pref__desc">Sitenin çalışması için gereklidir, devre dışı bırakılamaz.</span>
        </label>
        <input type="checkbox" id="cookie-pref-necessary" checked disabled>
      </div>
      <div class="cookie-pref">
        <label for="cookie-pref-analytics">
          <span class="cookie-pref__name">Analitik Çerezler</span>
          <span class="cookie-pref__desc">Site kullanımını anlamamıza yardımcı olur.</span>
        </label>
        <input type="checkbox" id="cookie-pref-analytics">
      </div>
      <button class="btn btn--light" type="button" data-cookie-save>Tercihleri Kaydet</button>
    </div>
    <div class="cookie-banner__actions">
      <button class="btn btn--light" type="button" data-cookie-accept>Kabul Et</button>
      <button class="btn btn--ghost-light" type="button" data-cookie-manage aria-expanded="false">Tercihleri Yönet</button>
      <button class="btn btn--ghost-light" type="button" data-cookie-reject>Reddet</button>
    </div>
  </aside>

  <!-- Randevu Modal -->
  <div class="modal" id="appointment-modal" role="dialog" aria-modal="true" aria-labelledby="appointment-title" aria-hidden="true">
    <div class="modal__backdrop" data-appointment-close></div>
    <div class="modal__panel">
      <button class="modal__close" type="button" aria-label="Pencereyi kapat" data-appointment-close>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <p class="eyebrow">Randevu</p>
      <h2 class="modal__title" id="appointment-title">Randevu Al</h2>
      <p class="modal__desc">
        Bilgilerinizi bırakın; randevunuzu planlamak için en kısa sürede
        sizinle iletişime geçelim.
      </p>
      <form class="modal__form" id="appointment-form" novalidate>
        <div class="form__field">
          <label class="form__label" for="ap-name">İsim Soyisim <span class="req" aria-hidden="true">*</span></label>
          <input class="form__input" type="text" id="ap-name" name="name" autocomplete="name" required aria-required="true">
          <p class="form__error">Lütfen isim ve soyisminizi giriniz.</p>
        </div>
        <div class="form__field">
          <label class="form__label" for="ap-phone">Telefon <span class="req" aria-hidden="true">*</span></label>
          <input class="form__input" type="tel" id="ap-phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="0(5__) ___ __ __" required aria-required="true">
          <p class="form__error">Lütfen geçerli bir telefon numarası giriniz.</p>
        </div>
        <div class="form__field">
          <label class="form__label" for="ap-email">E-mail <span class="req" aria-hidden="true">*</span></label>
          <input class="form__input" type="email" id="ap-email" name="email" autocomplete="email" required aria-required="true">
          <p class="form__error">Lütfen geçerli bir e-posta adresi giriniz.</p>
        </div>
        <div class="form__submit">
          <button class="btn" type="submit">Randevu Talebi Gönder</button>
          <p class="form__status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </div>

  <!-- Scripts -->
  <script is:inline define:vars={{ apiUrl: import.meta.env.PUBLIC_API_URL || 'http://kdbhukuk-admin.test/api' }}>
    window.__KDB_API_URL__ = apiUrl;
  </script>
  <script src="/assets/js/navigation.js" defer is:inline></script>
  <script src="/assets/js/animations.js" defer is:inline></script>
  <script src="/assets/js/cookies.js" defer is:inline></script>
  <script src="/assets/js/main.js" defer is:inline></script>
</body>
</html>
