---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getSiteSettings } from '../lib/api';

const page = await getPage('iletisim');
const f = page?.fields ?? {};
const siteSettings = await getSiteSettings();

// Ofis konumu panelden harita üzerinde işaretlenir. Eski kurulumlarda elle
// girilmiş bir Google Maps yerleştirme adresi kalmışsa o da desteklenir.
const pin = f.map_location as { lat?: number; lng?: number } | undefined;
const hasPin = typeof pin?.lat === 'number' && typeof pin?.lng === 'number';

// Eski kurulumlarda elle girilmiş yerleştirme adresi varsa korunur.
const legacyEmbedUrl = hasPin ? null : (f.map_embed_url || null);

const directionsUrl = hasPin
  ? `https://www.google.com/maps/search/?api=1&query=${pin!.lat}%2C${pin!.lng}`
  : (siteSettings.address
      ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteSettings.address)}`
      : null);

const arrowIcon = `<svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path d="M4 12h16m0 0-6-6m6 6-6 6"/></svg>`;

const jsonLd = {
  '@graph': [
    {
      '@type': 'LegalService',
      '@id': 'https://www.kdbhukuk.com/#legalservice',
      name: 'KDB Hukuk',
      url: 'https://www.kdbhukuk.com/',
      telephone: siteSettings.phone || 'TODO',
      email: siteSettings.email || 'TODO',
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteSettings.address || 'TODO',
        addressCountry: 'TR',
      },
      ...(hasPin ? { geo: { '@type': 'GeoCoordinates', latitude: pin!.lat, longitude: pin!.lng } } : {}),
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://www.kdbhukuk.com/' },
        { '@type': 'ListItem', position: 2, name: 'İletişim', item: 'https://www.kdbhukuk.com/iletisim' },
      ],
    },
  ],
};
---

<BaseLayout
  title={page?.meta_title || 'İletişim | KDB Hukuk — Av. Kaan Durali Bulut'}
  description={page?.meta_description || 'KDB Hukuk ile iletişime geçin. Hukuki sürecinizi değerlendirmek ve randevu talebi oluşturmak için iletişim formunu kullanabilirsiniz.'}
  canonicalPath="/iletisim"
  activeNav="contact"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container page-hero__grid">
      <div>
        <nav class="breadcrumb" aria-label="Sayfa konumu">
          <ol>
            <li><a href="/">Ana Sayfa</a></li>
            <li><span aria-current="page">İletişim</span></li>
          </ol>
        </nav>
        <p class="eyebrow reveal">İletişim</p>
        <h1 class="page-hero__title reveal" id="page-title" data-reveal-delay="80">Bizimle İletişime Geçin</h1>
        <p class="lead page-hero__desc reveal" data-reveal-delay="160">
          {f.intro_text || 'Hukuki sürecinizi değerlendirmek ve doğru yol haritasını oluşturmak için bize ulaşabilirsiniz.'}
        </p>
      </div>
      <p class="page-hero__aside reveal" data-reveal-delay="240">
        Form üzerinden ilettiğiniz talepler, en kısa sürede değerlendirilerek
        size dönüş yapılır.
      </p>
    </div>
  </section>

  <!-- İletişim -->
  <section class="section" aria-label="İletişim bilgileri ve form">
    <div class="container contact-layout">

      <!-- Bilgiler -->
      <div class="contact-info">
        <div class="contact-block reveal">
          <p class="contact-block__label">Telefon</p>
          <p class="contact-block__value office-phone">{siteSettings.phone || 'Telefon bilgisi eklenecektir'}</p>
          <p class="contact-block__note">Mesai saatleri içinde ulaşabilirsiniz.</p>
        </div>

        <div class="contact-block reveal" data-reveal-delay="60">
          <p class="contact-block__label">E-posta</p>
          <p class="contact-block__value office-email">{siteSettings.email || 'E-posta bilgisi eklenecektir'}</p>
          <p class="contact-block__note">E-postalarınıza en geç bir iş günü içinde dönüş yapılır.</p>
        </div>

        <div class="contact-block reveal" data-reveal-delay="120">
          <p class="contact-block__label">WhatsApp</p>
          <p class="contact-block__value office-whatsapp">{siteSettings.whatsapp || 'WhatsApp bilgisi eklenecektir'}</p>
          <p class="contact-block__note">Yazılı ön bilgilendirme talepleri için kullanılabilir.</p>
        </div>

        <div class="contact-block reveal" data-reveal-delay="180">
          <p class="contact-block__label">Adres</p>
          <p class="contact-block__value office-address">{siteSettings.address || 'Adres bilgisi eklenecektir'}</p>
          <p class="contact-block__note">Görüşmeler randevu ile gerçekleştirilir.</p>
        </div>

        <div class="contact-block reveal" data-reveal-delay="240">
          <p class="contact-block__label">Çalışma Saatleri</p>
          <p class="contact-block__value">{siteSettings.working_hours || 'Hafta içi 09.00 — 18.00'}</p>
          <p class="contact-block__note">Hafta sonu görüşmeleri önceden randevu ile planlanır.</p>
        </div>
      </div>

      <!-- Form -->
      <div>
        <form class="form reveal" id="contact-form" novalidate>
          <div class="form__field">
            <label class="form__label" for="cf-name">Ad Soyad <span class="req" aria-hidden="true">*</span></label>
            <input class="form__input" type="text" id="cf-name" name="name" autocomplete="name" required aria-required="true">
            <p class="form__error" id="cf-name-error">Lütfen adınızı ve soyadınızı giriniz.</p>
          </div>

          <div class="form__field">
            <label class="form__label" for="cf-phone">Telefon <span class="req" aria-hidden="true">*</span></label>
            <input class="form__input" type="tel" id="cf-phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="0(5__) ___ __ __" required aria-required="true">
            <p class="form__error" id="cf-phone-error">Lütfen geçerli bir telefon numarası giriniz.</p>
          </div>

          <div class="form__field form__field--full">
            <label class="form__label" for="cf-email">E-posta <span class="req" aria-hidden="true">*</span></label>
            <input class="form__input" type="email" id="cf-email" name="email" autocomplete="email" required aria-required="true">
            <p class="form__error" id="cf-email-error">Lütfen geçerli bir e-posta adresi giriniz.</p>
          </div>

          <div class="form__field form__field--full">
            <label class="form__label" for="cf-subject">Konu <span class="req" aria-hidden="true">*</span></label>
            <select class="form__select" id="cf-subject" name="subject" required aria-required="true">
              <option value="" selected>Konu seçiniz</option>
              <option value="ceza">Ceza Hukuku</option>
              <option value="gayrimenkul">Gayrimenkul Hukuku</option>
              <option value="ticaret">Ticaret Hukuku</option>
              <option value="is">İş Hukuku</option>
              <option value="aile">Aile Hukuku</option>
              <option value="miras">Miras Hukuku</option>
              <option value="icra">İcra ve İflas Hukuku</option>
              <option value="sozlesme">Sözleşmeler Hukuku</option>
              <option value="tazminat">Tazminat Hukuku</option>
              <option value="danismanlik">Hukuki Danışmanlık</option>
              <option value="diger">Diğer</option>
            </select>
            <p class="form__error" id="cf-subject-error">Lütfen bir konu seçiniz.</p>
          </div>

          <div class="form__field form__field--full">
            <label class="form__label" for="cf-message">Mesajınız <span class="req" aria-hidden="true">*</span></label>
            <textarea class="form__textarea" id="cf-message" name="message" required aria-required="true" placeholder="Hukuki talebinizi kısaca özetleyiniz. Lütfen bu alanda özel nitelikli kişisel verilerinizi paylaşmayınız."></textarea>
            <p class="form__error" id="cf-message-error">Lütfen en az 20 karakterlik bir mesaj yazınız.</p>
          </div>

          <label class="form__consent">
            <input type="checkbox" name="kvkk" required aria-required="true">
            <span>
              <a href="/kvkk">KVKK Aydınlatma Metni</a>'ni okudum;
              kişisel verilerimin iletişim talebimin karşılanması amacıyla
              işlenmesine onay veriyorum.
              <span class="req" aria-hidden="true">*</span>
            </span>
          </label>

          <div class="form__submit">
            <button class="btn" type="submit">Gönder</button>
            <p class="form__status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>

    <!-- Harita -->
    <div class="container">
      {(hasPin || legacyEmbedUrl) ? (
        <div class="map-block reveal">
          {hasPin ? (
            <div
              class="map-block__frame"
              id="office-map"
              data-lat={String(pin!.lat)}
              data-lng={String(pin!.lng)}
              data-label={siteSettings.address || 'KDB Hukuk'}
              role="img"
              aria-label={`KDB Hukuk ofis konumu haritası${siteSettings.address ? ' — ' + siteSettings.address : ''}`}
            ></div>
          ) : (
            <div class="map-block__frame">
              <iframe src={legacyEmbedUrl} width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="KDB Hukuk ofis konumu" />
            </div>
          )}
          {directionsUrl && (
            <div class="map-block__actions">
              <a class="btn" href={directionsUrl} target="_blank" rel="noopener noreferrer">
                Konuma Git
                <span class="arrow" aria-hidden="true" set:html={arrowIcon} />
              </a>
              <p class="map-block__note">Bağlantı yol tarifi için harita uygulamasında açılır.</p>
            </div>
          )}
        </div>
      ) : (
        <div class="map-placeholder reveal" role="img" aria-label="Ofis konumu harita alanı">
          <p class="map-placeholder__label">
            <strong>Harita Alanı</strong>
            Ofis konumu panelden haritaya işaretlendiğinde burada görüntülenecektir.
          </p>
        </div>
      )}
    </div>
  </section>

  {hasPin && (
    <script is:inline>
      (function () {
        var el = document.getElementById('office-map');
        if (!el) return;

        var loaded = false;

        function load() {
          if (loaded) return;
          loaded = true;

          var css = document.createElement('link');
          css.rel = 'stylesheet';
          css.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css';
          document.head.appendChild(css);

          var script = document.createElement('script');
          script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js';
          script.onload = init;
          document.head.appendChild(script);
        }

        function init() {
          var lat = parseFloat(el.dataset.lat);
          var lng = parseFloat(el.dataset.lng);
          if (isNaN(lat) || isNaN(lng)) return;

          var map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 16);

          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap katkıda bulunanları',
          }).addTo(map);

          L.marker([lat, lng]).addTo(map).bindPopup(el.dataset.label || 'KDB Hukuk');
        }

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                load();
                observer.disconnect();
              }
            });
          }, { rootMargin: '200px' });
          observer.observe(el);
        } else {
          load();
        }
      })();
    </script>
  )}
</BaseLayout>
